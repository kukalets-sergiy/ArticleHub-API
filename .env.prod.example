# MongoDB connection
MONGODB_HOST=mongodb://root:root@mongo:27017/mongo?authSource=admin
MONGODB_NAME=mongo
MONGODB_USERNAME=root
MONGODB_PASSWORD=root

# Django secret key
SECRET_KEY=your_prod_secret_key

# Redis connection
REDIS_HOST=redis
REDIS_PORT=6379

# API version
API_VERSION=v1

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=lightray.live

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://lightray.live

# Debug mode (should be False in prod)
DEBUG=False